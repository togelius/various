     return std::chrono::duration<double>(Clock::now() - start).count();
 }
 
+// scriptprof: adaptive clock polling for the search loops.
+//
+// Upstream consults the clock every 1000 expansions, which assumes expansions
+// are cheap. In games whose rules loop heavily a single expansion can take
+// tens of milliseconds, so a 1s budget could run for 78s. A small fixed
+// stride fixes that but taxes fast searches, which poll far more often than
+// they need to.
+//
+// This poller measures how long expansions actually take and retunes its
+// stride to land roughly kPollsPerBudget checks inside the budget. Slow games
+// converge to checking every iteration; fast games settle on a stride wider
+// than upstream's, so they poll less than before.
+constexpr int kPollsPerBudget = 64;
+constexpr long long kMaxStride = 4096;
+
+class TimeoutPoller {
+public:
+    TimeoutPoller(const Clock::time_point& start, int timeoutMs)
+        : timeoutMs_(timeoutMs), lastTime_(start) {}
+
+    // Call once per iteration with a monotonically increasing counter.
+    bool expired(const Clock::time_point& start, long long iter) {
+        if (timeoutMs_ <= 0 || iter < nextIter_) {
+            return false;
+        }
+        const auto now = Clock::now();
+        if (std::chrono::duration<double, std::milli>(now - start).count() > timeoutMs_) {
+            return true;
+        }
+        const double sinceMs = std::chrono::duration<double, std::milli>(now - lastTime_).count();
+        const long long done = iter - lastIter_;
+        if (done > 0 && sinceMs > 0.0) {
+            const double perIterMs = sinceMs / static_cast<double>(done);
+            const double targetMs = std::max(1.0, static_cast<double>(timeoutMs_) / kPollsPerBudget);
+            const long long tuned = static_cast<long long>(targetMs / perIterMs);
+            stride_ = std::min(kMaxStride, std::max(1LL, tuned));
+        }
+        lastTime_ = now;
+        lastIter_ = iter;
+        nextIter_ = iter + stride_;
+        return false;
+    }
+
+private:
+    int timeoutMs_;
+    Clock::time_point lastTime_;
+    long long lastIter_ = 0;
+    long long nextIter_ = 0;
+    long long stride_ = 16;
+};
